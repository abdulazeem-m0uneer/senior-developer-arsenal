#!/usr/bin/env bash
# ==============================================================================
# arsenal - Senior Developer Arsenal CLI for Ubuntu / Linux / WSL
# ==============================================================================
set -euo pipefail

# Resolve arsenal repository root (resolving symlinks if installed in PATH)
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
ARSENAL_DIR="$(cd -P "$(dirname "$SOURCE")/.." && pwd)"

SOURCE_AGENTS="$ARSENAL_DIR/.agents"
SOURCE_AGENTS_MD="$ARSENAL_DIR/AGENTS.md"
GLOBAL_CONFIG="$HOME/.gemini/config"
GLOBAL_SKILLS="$GLOBAL_CONFIG/skills"
GLOBAL_RULES="$GLOBAL_CONFIG/rules"

# ANSI Colors
CYAN='\033[0;36m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m' # No Color

show_help() {
  echo -e "${CYAN}==================================================${NC}"
  echo -e "${CYAN}   🚀 Senior Developer Arsenal CLI (Ubuntu / Linux)${NC}"
  echo -e "${CYAN}==================================================${NC}"
  echo ""
  echo "Usage: arsenal <command> [options]"
  echo ""
  echo "Commands:"
  echo "  sync / global          Synchronize skills and rules into ~/.gemini/config"
  echo "  link [project_path]    Symlink .agents and AGENTS.md into target project (default: current dir)"
  echo "  copy [project_path]    Copy .agents and AGENTS.md into target project (default: current dir)"
  echo "  status                 Display installed rules and skills status"
  echo "  update                 Pull latest git changes and re-sync globally"
  echo "  help                   Show this help message"
  echo ""
}

cmd_sync() {
  echo -e "${YELLOW}[+] Synchronizing globally into: $GLOBAL_CONFIG${NC}"
  mkdir -p "$GLOBAL_SKILLS" "$GLOBAL_RULES"

  local skill_count=0
  for skill_dir in "$SOURCE_AGENTS/skills/"*; do
    if [ -d "$skill_dir" ]; then
      skill_name="$(basename "$skill_dir")"
      target="$GLOBAL_SKILLS/$skill_name"
      rm -rf "$target"
      cp -r "$skill_dir" "$target"
      echo -e "  -> ${GREEN}Skill installed:${NC} $skill_name"
      ((skill_count++))
    fi
  done

  local rule_count=0
  for rule_file in "$SOURCE_AGENTS/rules/"*.md; do
    if [ -f "$rule_file" ]; then
      rule_name="$(basename "$rule_file")"
      target="$GLOBAL_RULES/$rule_name"
      cp "$rule_file" "$target"
      echo -e "  -> ${GREEN}Rule installed:${NC} $rule_name"
      ((rule_count++))
    fi
  done

  echo ""
  echo -e "${GREEN}[SUCCESS] Installed $skill_count skills and $rule_count rules into $GLOBAL_CONFIG${NC}"
}

cmd_link() {
  local target_dir="${1:-.}"
  target_dir="$(cd "$target_dir" && pwd)"

  echo -e "${YELLOW}[+] Symlinking Arsenal into: $target_dir${NC}"
  rm -rf "$target_dir/.agents" "$target_dir/AGENTS.md"

  ln -s "$SOURCE_AGENTS" "$target_dir/.agents"
  ln -s "$SOURCE_AGENTS_MD" "$target_dir/AGENTS.md"

  echo -e "${GREEN}[SUCCESS] Created symlinks in $target_dir${NC}"
  echo "  .agents   -> $SOURCE_AGENTS"
  echo "  AGENTS.md -> $SOURCE_AGENTS_MD"
}

cmd_copy() {
  local target_dir="${1:-.}"
  target_dir="$(cd "$target_dir" && pwd)"

  echo -e "${YELLOW}[+] Copying Arsenal into: $target_dir${NC}"
  rm -rf "$target_dir/.agents" "$target_dir/AGENTS.md"

  cp -r "$SOURCE_AGENTS" "$target_dir/.agents"
  cp "$SOURCE_AGENTS_MD" "$target_dir/AGENTS.md"

  echo -e "${GREEN}[SUCCESS] Copied .agents and AGENTS.md into $target_dir${NC}"
}

cmd_status() {
  echo -e "${CYAN}=== Arsenal Global Status (~/.gemini/config) ===${NC}"
  if [ -d "$GLOBAL_SKILLS" ]; then
    echo -e "${YELLOW}Active Skills:${NC}"
    for s in "$GLOBAL_SKILLS/"*; do
      [ -d "$s" ] && echo "  - $(basename "$s")"
    done
  else
    echo "  No skills directory found at $GLOBAL_SKILLS"
  fi

  if [ -d "$GLOBAL_RULES" ]; then
    echo -e "\n${YELLOW}Active Rules:${NC}"
    for r in "$GLOBAL_RULES/"*.md; do
      [ -f "$r" ] && echo "  - $(basename "$r")"
    done
  else
    echo "  No rules directory found at $GLOBAL_RULES"
  fi
}

cmd_update() {
  echo -e "${YELLOW}[+] Checking for git updates in $ARSENAL_DIR...${NC}"
  if [ -d "$ARSENAL_DIR/.git" ]; then
    git -C "$ARSENAL_DIR" pull --ff-only || {
      echo -e "${RED}[WARNING] git pull failed or repository has local changes.${NC}"
    }
  fi
  cmd_sync
}

# Main routing
case "${1:-}" in
  sync|global)
    cmd_sync
    ;;
  link)
    cmd_link "${2:-.}"
    ;;
  copy)
    cmd_copy "${2:-.}"
    ;;
  status)
    cmd_status
    ;;
  update)
    cmd_update
    ;;
  help|--help|-h|"")
    show_help
    ;;
  *)
    echo -e "${RED}Unknown command: $1${NC}"
    show_help
    exit 1
    ;;
esac
