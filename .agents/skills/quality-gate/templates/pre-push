#!/bin/sh
# Pre-push hook template (quality-gate skill): affected tests, then changed-lines coverage, then one CI run
# per branch. Copy to .git/hooks/pre-push (or call it from husky, lefthook or pre-commit) and set the four
# values below for the project, here or in the environment. Each step's own exit code stops the push.
#   AFFECTED_TESTS_CMD    the project's command that runs the tests the change affects and writes coverage
#   COVERAGE_REPORT       the lcov.info or Cobertura XML that command writes
#   PUSH_BASE             the ref changed lines are measured against, and push_once's rebase base
#   ARSENAL_PUSH_BASE     optional: a base such as origin/development; push_once fetches it and refuses a push
#                         that does not contain its tip (ARSENAL_ALLOW_STALE_BASE=1 passes, logged)
#   ARSENAL_TEST_LOG      where the affected tests' output is kept (default .agents/test-run.log, appended to, trimmed to its last 2 MiB once over 5 MiB); push_once refuses
#                         a push when CI's last red run failed test files that no run after a newer `### arsenal-test-run <epoch>` marker names
#                         (ARSENAL_ALLOW_UNRUN_RED=<reason> passes, logged)
#   ARSENAL_QUALITY_GATE  the folder holding changed_coverage.py and push_once.py
# Tests and coverage measure the checked-out HEAD, so they run only when a pushed branch is at HEAD; a
# deletion, a tag, or a branch other than the checked-out one goes straight to push_once (noted on stderr).
# Never skip it with --no-verify; the opt-outs are ARSENAL_PUSH_REBASE=1 and ARSENAL_ALLOW_PUSH=1: either one
# skips tests and coverage and makes push_once pass, which logs it to .agents/ci-optouts.log.
set -u
AFFECTED_TESTS_CMD="${AFFECTED_TESTS_CMD:-npm run test:affected -- --coverage}"
COVERAGE_REPORT="${COVERAGE_REPORT:-coverage/lcov.info}"
PUSH_BASE="${PUSH_BASE:-origin/main}"
ARSENAL_QUALITY_GATE="${ARSENAL_QUALITY_GATE:-.agents/skills/quality-gate/scripts}"

pushes=$(cat)   # git's push lines; read once, before any step can consume stdin

head=$(git rev-parse --verify --quiet HEAD) || head=none
at_head=no
while read -r _ local_sha remote_ref _; do
  case "$remote_ref" in refs/heads/*) [ "$local_sha" = "$head" ] && at_head=yes ;; esac
done <<PUSHES
$pushes
PUSHES

if [ "${ARSENAL_ALLOW_PUSH:-}" = 1 ]; then
  skip="ARSENAL_ALLOW_PUSH=1"
elif [ "${ARSENAL_PUSH_REBASE:-}" = 1 ]; then
  skip="ARSENAL_PUSH_REBASE=1"
elif [ "$at_head" = no ]; then
  skip="no pushed branch is at HEAD"
else
  skip=""
fi

if [ -n "$skip" ]; then
  echo "pre-push: $skip: affected tests and changed-lines coverage skipped" >&2
else
  test_log="${ARSENAL_TEST_LOG:-.agents/test-run.log}"
  mkdir -p "$(dirname "$test_log")"
  # The log accumulates, so a rerun of a few files keeps what earlier runs named; over 5 MiB, only the last 2 MiB stay.
  if [ -f "$test_log" ] && [ "$(wc -c <"$test_log")" -gt 5242880 ]; then
    tail -c 2097152 "$test_log" >"$test_log.tmp" && mv "$test_log.tmp" "$test_log"
  fi
  printf '### arsenal-test-run %s\n' "$(date +%s)" >>"$test_log"   # push_once counts only the text after a marker newer than the red record
  # tee streams the output to the terminal while it is appended to the log; plain sh has no PIPESTATUS, so the
  # runner's own exit code goes through a temp file.
  rc_file=
  trap 'rm -f "$rc_file"' EXIT   # an EXIT trap keeps the exit status; INT and TERM exit with 128+signal, which runs it
  trap 'exit 130' INT
  trap 'exit 143' TERM
  rc_file=$(mktemp) || exit 1
  { sh -c "$AFFECTED_TESTS_CMD" </dev/null 2>&1; echo $? >"$rc_file"; } | tee -a "$test_log"
  tests_rc=$(cat "$rc_file"); rm -f "$rc_file"
  [ -n "$tests_rc" ] || tests_rc=1   # the runner never reported: fail
  [ "$tests_rc" -eq 0 ] || exit "$tests_rc"
  python3 "$ARSENAL_QUALITY_GATE/changed_coverage.py" --report "$COVERAGE_REPORT" --base "$PUSH_BASE" --min 90 \
    || exit $?
fi
printf '%s\n' "$pushes" | python3 "$ARSENAL_QUALITY_GATE/push_once.py" hook "$@" --base "$PUSH_BASE"
