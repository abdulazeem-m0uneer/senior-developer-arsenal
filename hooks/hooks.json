{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/session_core.py\" || python \"${CLAUDE_PLUGIN_ROOT}/hooks/session_core.py\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/.agents/skills/lessons-learned/scripts/lessons.py\" active --hook || python \"${CLAUDE_PLUGIN_ROOT}/.agents/skills/lessons-learned/scripts/lessons.py\" active --hook",
            "timeout": 10,
            "statusMessage": "Loading lessons learned..."
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/.agents/skills/handoff/scripts/snapshot.py\" show || python \"${CLAUDE_PLUGIN_ROOT}/.agents/skills/handoff/scripts/snapshot.py\" show",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.py\" baseline || python \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.py\" baseline",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/.agents/skills/handoff/scripts/snapshot.py\" prompt || python \"${CLAUDE_PLUGIN_ROOT}/.agents/skills/handoff/scripts/snapshot.py\" prompt",
            "timeout": 5
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/.agents/skills/handoff/scripts/snapshot.py\" write || python \"${CLAUDE_PLUGIN_ROOT}/.agents/skills/handoff/scripts/snapshot.py\" write",
            "timeout": 20
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.py\" pre || python \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.py\" pre",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.py\" track || python \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.py\" track",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.py\" track || python \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.py\" track",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.py\" stop || python \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.py\" stop",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
